{"name": "zoo-editor-hider", "displayName": "Zoo Editor Hider", "description": "Make ZooCode truly fill the entire VS Code window: open it as the only editor tab, close ALL non-ZooCode tabs via tabGroups iteration, right sidebar, bottom panel, left sidebar and activity bar. Toggle with Ctrl+Alt+Z.", "version": "0.3.11", "publisher": "tt-hider", "engines": {"vscode": "^1.65.0"}, "categories": ["Other"], "keywords": ["layout", "sidebar", "fullscreen", "editor", "zoo"], "activationEvents": ["onStartupFinished"], "main": "./out/extension.js", "contributes": {"commands": [{"command": "zoo-editor-hider.toggle", "title": "Toggle Zoo Fullscreen", "category": "Zoo Editor Hider"}, {"command": "zoo-editor-hider.fullscreenZoo", "title": "Zoo Fullscreen (fill window with ZooCode)", "category": "Zoo Editor Hider"}, {"command": "zoo-editor-hider.restore", "title": "Restore Layout", "category": "Zoo Editor Hider"}], "keybindings": [{"command": "zoo-editor-hider.toggle", "key": "ctrl+alt+z", "mac": "cmd+alt+z"}], "configuration": {"title": "Zoo Editor Hider", "properties": {"zooEditorHider.autoHideOnStartup": {"type": "boolean", "default": false, "description": "Automatically make ZooCode fill the window on startup (default OFF - use Ctrl+Alt+Z manually)."}}}}, "devDependencies": {"@vscode/vsce": "^2.22.0"}, "scripts": {"package": "vsce package"}}
